# ---------------------------------------------------------------
# FitTrack Community - backend environment (PRODUCTION)
# Copy to `.env` (or `.env.production`) on the server and fill in
# real values. `NODE_ENV=production` makes the server refuse to boot
# unless JWT_SECRET is strong and CORS_ORIGIN lists explicit origins.
# ---------------------------------------------------------------

NODE_ENV=production

# Port the Express API listens on (behind your reverse proxy).
PORT=5000

# Persistent MongoDB connection string.
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fittrack
MONGODB_URI=mongodb://localhost:27017/fittrack

# REQUIRED: long, random, unique secret (>= 32 chars).
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-64-character-random-secret-value-xxxxxxxxxxxxxxxx

# How long a signed-in session stays valid.
JWT_EXPIRES_IN=7d

# REQUIRED: explicit, comma-separated frontend origin(s). No wildcard.
CORS_ORIGIN=https://app.fittrack.example.com

# Set when running behind a reverse proxy/load balancer so `req.ip` and
# rate limiting see the real client (true | false | hop count | subnet).
TRUST_PROXY=1

# Where uploaded avatar images are written (relative to `backend/`).
UPLOADS_DIR=uploads

# Maximum avatar upload size in bytes (5 MB).
MAX_UPLOAD_BYTES=5242880

# Password assigned to seeded demo accounts (change or disable seeding).
DEMO_PASSWORD=change-me-before-seeding

# Log every non-health request (true | false).
LOG_REQUESTS=true
