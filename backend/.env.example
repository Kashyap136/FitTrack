# ---------------------------------------------------------------
# FitTrack Community - backend environment
# Copy this file to `.env` and adjust for your machine.
# ---------------------------------------------------------------

# Port the Express API listens on.
PORT=5000

# MongoDB connection string.
# Local install:  mongodb://localhost:27017/fittrack
# Atlas example:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fittrack
MONGODB_URI=mongodb://localhost:27017/fittrack

# Secret used to sign JWTs. Change this to a long random string.
JWT_SECRET=secret

# How long a signed-in session stays valid.
JWT_EXPIRES_IN=7d

# Comma separated list of allowed browser origins. Leave empty to allow any.
CORS_ORIGIN=http://localhost:3000

# Where uploaded avatar images are written (relative to `backend/`).
UPLOADS_DIR=uploads

# Maximum avatar upload size in bytes (5 MB).
MAX_UPLOAD_BYTES=5242880

# Password assigned to every seeded demo account by `npm run seed`.
DEMO_PASSWORD=FitTrack@123

# development | production | test
NODE_ENV=development
